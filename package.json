{
  "name": "earth",
  "version": "0.0.0",
  "private": true,
  "author": "Sumit Suman",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "gibs:catalog": "node scripts/gibs-catalog.mjs",
    "accept:M0": "playwright test --grep \"@M0\\b\"",
    "textures": "node scripts/textures/build-earth-textures.mjs && node scripts/textures/build-night-lights.mjs && node scripts/textures/build-clouds.mjs",
    "accept:M1": "playwright test --grep \"@M[01]\\b\"",
    "accept:M2": "playwright test --grep \"@M[012]\\b\""
  },
  "dependencies": {
    "cesium": "1.147.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/three": "latest",
    "playwright-core": "1.64.1",
    "sharp": "^0.34.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
